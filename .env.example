# Copy to .env to override the defaults used by docker-compose.yml. Every variable is optional.
# Never commit a real .env (it is git-ignored); this file holds placeholders only.

# Signing secret for the JWT tokens (HS256): at least 32 bytes. The compose file has a dev-only default;
# generate your own for anything shared, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Database credentials (used by both the postgres and the backend containers).
POSTGRES_DB=pokedex
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex

# On startup the backend copies Pokemon #1-#12 from PokeAPI into the local collection (in the background).
# Set to false to start empty, or to run without internet access.
SEED_ENABLED=true

# Host ports. Change one when it is already taken on your machine (e.g. a local PostgreSQL on 5432).
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=5432
